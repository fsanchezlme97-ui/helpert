{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Helpert",
  "version": "0.1.0",
  "identifier": "pe.helpert.bandeja",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "chat", "title": "Helpert · soporte TI", "width": 400, "height": 620, "visible": false,
        "decorations": false, "transparent": true, "shadow": false, "resizable": false, "skipTaskbar": true, "alwaysOnTop": true }
    ],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["iconos/icono.png"] }
}
