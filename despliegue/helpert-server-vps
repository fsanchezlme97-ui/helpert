#!/usr/bin/env bash
# /usr/local/bin/helpert-server en la VPS (lo instala instalar-servidor.sh): la orden de administración del servidor,
# como el usuario helpert y con los secretos de /etc/helpert/servidor.env, que se leen del archivo (no van en argumentos).
#   sudo helpert-server revisar · sudo helpert-server usuario-consola correo --rol admin · sudo helpert-server purgar
set -euo pipefail
if [ "$(id -un)" != helpert ]; then exec sudo -u helpert -H "$0" "$@"; fi
while IFS= read -r linea; do
  [[ "$linea" =~ ^([A-Z_][A-Z0-9_]*)=(.*)$ ]] && export "${BASH_REMATCH[1]}=${BASH_REMATCH[2]}"
done < /etc/helpert/servidor.env
cd /opt/helpert/server
exec uv run --frozen -q helpert-server --config /etc/helpert/helpert-server.toml "$@"
